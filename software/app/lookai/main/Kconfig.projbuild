menu "LookAI"

    config LOOKAI_STT_API_KEY
        string "STT API key"
        default ""
        help
            API key used by the LookAI STT client.
            For Groq, paste your Groq API key here.
            Keep this private. Do not print this value in logs.

    config LOOKAI_STT_ENDPOINT
        string "STT endpoint"
        default "https://api.groq.com/openai/v1/audio/transcriptions"
        help
            OpenAI-compatible audio transcription endpoint.
            Default value uses Groq's OpenAI-compatible transcription endpoint.

    config LOOKAI_STT_MODEL
        string "STT model"
        default "whisper-large-v3-turbo"
        help
            Audio transcription model used by the STT API client.
            For Groq, use whisper-large-v3-turbo or whisper-large-v3.

    config LOOKAI_STT_LANGUAGE
        string "STT language code"
        default "tr"
        help
            Optional ISO-639-1 language code for the input audio.
            Use an empty value to let the API auto-detect the language.

    config LOOKAI_TTS_API_KEY
        string "TTS API key"
        default ""
        help
            Optional API key used by the LookAI TTS client.
            Leave empty to reuse LOOKAI_STT_API_KEY for Groq.

    config LOOKAI_TTS_ENDPOINT
        string "TTS endpoint"
        default "https://api.groq.com/openai/v1/audio/speech"
        help
            OpenAI-compatible audio speech endpoint.
            Default value uses Groq's text-to-speech endpoint.

    config LOOKAI_TTS_MODEL
        string "TTS model"
        default "canopylabs/orpheus-v1-english"
        help
            Text-to-speech model used by the TTS API client.
            Groq currently supports canopylabs/orpheus-v1-english and canopylabs/orpheus-arabic-saudi.

    config LOOKAI_TTS_VOICE
        string "TTS voice"
        default "hannah"
        help
            Voice persona ID used by the TTS API client.
            English voices include autumn, diana, hannah, austin, daniel, and troy.

    config LOOKAI_TTS_RESPONSE_FORMAT
        string "TTS response format"
        default "wav"
        help
            Audio response format for generated speech. Groq Orpheus currently supports wav.

endmenu
